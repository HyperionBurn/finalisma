# Local Compose/SMTP credentials; never commit deployment secrets.
.env
.env.*
!.env.example

# Film render + verification output (large binaries, regenerated by `npm run render`)
video/renders/
video/*.png

# Astro emits a server manifest into the static outDir. Its content embeds
# ABSOLUTE MACHINE PATHS (cacheDir/outDir/srcDir), so the hash changes on
# every machine/worktree and it is not a reproducible, committable artifact.
# The site never references it; guard-legacy ignores it too.
site/manifest_*.mjs

# Release materializer output. Built fresh by the Vercel build command
# (scripts/vercel-build.py); never committed, never edited by hand.
artifacts/release-site/

.vercel

.env*
