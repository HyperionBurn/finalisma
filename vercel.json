{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "artifacts/release-site",
  "framework": null,
  "buildCommand": "python scripts/vercel-build.py",
  "installCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "WEFT_CONTACT_URL": "mailto:wasif@wasifwaseem.tech"
    }
  },
  "redirects": [
    {
      "source": "/signup",
      "destination": "https://weft.switzerlandnorth.cloudapp.azure.com/signup",
      "permanent": false
    },
    {
      "source": "/login",
      "destination": "https://weft.switzerlandnorth.cloudapp.azure.com/login",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "https://weft.switzerlandnorth.cloudapp.azure.com/app",
      "permanent": false
    },
    {
      "source": "/app/:path*",
      "destination": "https://weft.switzerlandnorth.cloudapp.azure.com/app/:path*",
      "permanent": false
    }
  ]
}
