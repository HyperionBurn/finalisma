---
/**
 * /app — the overview.
 *
 * The rooms themselves come from RoomsList, which asks the service. This
 * page holds no data of its own: it once carried a sample ROOMS array that
 * was never rendered, and a hardcoded "4 of 5 used" counter that was, and
 * both said things about the account that were not true.
 */
import AppShell from '../../layouts/AppShell.astro';
import RoomsList from '../../components/app/RoomsList.tsx';

---

<AppShell title="Rooms">
  <header class="bar">
    <h1 class="bar__t">Rooms</h1>
    <span class="bar__sp"></span>
    <a class="btn btn--quiet" href="/app/connect">Connect an agent</a>
    <a class="btn btn--pri" href="/app/new">New room</a>
  </header>

  <div class="scroll">
    <div class="pad">

      <RoomsList client:load />

    </div>
  </div>
</AppShell>
