---
import RootLayout from '../layouts/RootLayout.astro';
import Header from '../components/Header.astro';
import HeroWebGL from '../components/HeroWebGL.astro';
import ScrollController from '../components/ScrollController.tsx';
import Marquee from '../components/Marquee.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LiveDemo from '../components/LiveDemo.astro';
import ConnectTiers from '../components/ConnectTiers.astro';
import Proof from '../components/Proof.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<RootLayout>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <HeroWebGL />
    <ScrollController client:only="visible" />

    <Marquee />
    <Problem />
    <HowItWorks />
    <LiveDemo />
    <ConnectTiers />
    <Proof />
    <Pricing />
  </main>

  <Footer />
</RootLayout>
