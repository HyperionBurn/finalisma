---
import RootLayout from '../layouts/RootLayout.astro';
import Header from '../components/Header.astro';
import HeroWebGL from '../components/HeroWebGL.astro';
import ScrollController from '../components/ScrollController.tsx';
import Marquee from '../components/Marquee.astro';
import Problem from '../components/Problem.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LiveDemo from '../components/LiveDemo.astro';
import ConnectTiers from '../components/ConnectTiers.astro';
import Proof from '../components/Proof.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<RootLayout>
  <a class="skip-link" href="#main">Skip to content</a>

  <Header />

  <main id="main">
    <HeroWebGL />
    <ScrollController client:only="visible" />

    <Marquee />
    <Problem />
    <HowItWorks />
    <LiveDemo />
    <ConnectTiers />
    <Proof />
    <Pricing />
  </main>

  <Footer />
</RootLayout>

<script>
  // Shared scroll-entry IntersectionObserver — single instance, observes every
  // .scroll-in element and adds .in when >=20% visible. Per-element stagger
  // via inline --delay (ms). No window scroll listener.
  (function () {
    if (typeof window === 'undefined' || !('IntersectionObserver' in window)) {
      // No-IO fallback: reveal everything so content is never hidden.
      document.querySelectorAll('.scroll-in').forEach(function (el) {
        el.classList.add('in');
      });
      return;
    }

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          var el = entry.target;
          var delay = 0;
          var style = getComputedStyle(el);
          var delayRaw = style.getPropertyValue('--delay').trim();
          if (delayRaw) {
            delay = parseInt(delayRaw, 10);
            if (isNaN(delay)) delay = 0;
          }
          if (delay > 0) {
            setTimeout(function () { el.classList.add('in'); }, delay);
          } else {
            el.classList.add('in');
          }
          io.unobserve(el);
        });
      },
      { threshold: 0.2 }
    );

    function observeAll() {
      document.querySelectorAll('.scroll-in').forEach(function (el) {
        io.observe(el);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', observeAll);
    } else {
      observeAll();
    }
  })();
</script>
