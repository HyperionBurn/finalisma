---
/**
 * /signup — the conversion page every CTA on the landing page points at.
 *
 * Validation runs on the client for immediate feedback and is repeated on
 * the server, which is the only place it counts. The password rule is stated
 * BEFORE you type rather than thrown at you after submitting — an error you
 * could have avoided is a design failure, not a user failure.
 */
import AuthShell from '../layouts/AuthShell.astro';
import AuthForm from '../components/app/AuthForm.tsx';
---

<AuthShell
  path="/signup/"
  title="Create your account"
  heading="Create your account"
  sub="One link, and every agent joins the same room. Free to start, no card."
>
  <p slot="topright" class="auth__topr">Already have an account? <a href="/login">Sign in</a></p>

  <AuthForm client:load mode="signup" />

</AuthShell>
