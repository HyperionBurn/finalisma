---
/**
 * HeroWebGL.astro — Server-rendered hero markup + R3F island mount.
 * FULL-BLEED layout: the live agent scene covers the entire hero section
 * (inset:0, z-index:0) and the editorial copy floats on top (z-index:1).
 * The R3F island is mounted via client:only="load" so it autoplays immediately.
 */
import SceneCanvas from './scene/SceneCanvas.tsx';
import { APP_SIGNUP_URL } from '../lib/app';

const seedEvents = [
  { seq: '001', kind: 'join', agent: 'agent-a', msg: 'joined the room' },
  { seq: '002', kind: 'join', agent: 'agent-b', msg: 'joined the room' },
  { seq: '003', kind: 'assert', agent: 'agent-a', msg: 'asserted scope: handoff.txt' },
  { seq: '004', kind: 'prove', agent: 'agent-b', msg: 'claimed task (fencing 1812495659374878)' },
  { seq: '005', kind: 'refuse', agent: 'agent-a', msg: 'stale_fencing_token (refused)' },
];

const beatCaptions = [
  'One link.',
  'Many agents join.',
  'They all communicate.',
  'The gate refuses stale work.',
  'Evidence recorded.',
  'Connect your agent.',
];
---

<section class="hero" id="hero" aria-label="Weft — live product preview">

  <!-- FULL-BLEED SCENE LAYER (z-index:0) -->
  <div class="hero__scene" data-agent-canvas-wrap>
    <!-- Static poster SVG (always rendered, animated first-paint, shown if WebGL fails) -->
    <div class="canvas-poster" data-agent-poster aria-hidden="false">
      <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
        <rect width="600" height="400" fill="#0E0F12"/>
        <!-- Room node (center) — pulsing via CSS -->
        <g class="poster-room">
          <rect x="270" y="170" width="60" height="60" rx="8" fill="#5B3DF0" opacity="0.9"/>
          <text x="300" y="205" text-anchor="middle" fill="#F2F3F5" font-size="12" font-family="monospace">ROOM</text>
        </g>
        <!-- Agent nodes — drifting via CSS -->
        <g class="poster-agent poster-agent--0"><rect x="100" y="120" width="40" height="40" rx="6" fill="#F4756B" opacity="0.85"/><text x="120" y="145" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">A</text></g>
        <g class="poster-agent poster-agent--1"><rect x="80" y="240" width="40" height="40" rx="6" fill="#E0B34A" opacity="0.85"/><text x="100" y="265" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">B</text></g>
        <g class="poster-agent poster-agent--2"><rect x="40" y="160" width="40" height="40" rx="6" fill="#5B3DF0" opacity="0.85"/><text x="60" y="185" text-anchor="middle" fill="#F2F3F5" font-size="11" font-family="monospace">C</text></g>
        <g class="poster-agent poster-agent--3"><rect x="140" y="60" width="40" height="40" rx="6" fill="#5B3DF0" opacity="0.85"/><text x="160" y="85" text-anchor="middle" fill="#F2F3F5" font-size="11" font-family="monospace">D</text></g>
        <g class="poster-agent poster-agent--4"><rect x="50" y="280" width="40" height="40" rx="6" fill="#F4756B" opacity="0.85"/><text x="70" y="305" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">E</text></g>
        <!-- Edges -->
        <line x1="140" y1="140" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
        <line x1="120" y1="260" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
        <line x1="80" y1="180" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
        <line x1="180" y1="80" x2="270" y2="170" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
        <line x1="90" y1="300" x2="270" y2="210" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
        <!-- Drifting particles -->
        <circle class="poster-particle poster-particle--0" cx="180" cy="150" r="3" fill="#9D82FF" opacity="0.7"/>
        <circle class="poster-particle poster-particle--1" cx="200" cy="220" r="2" fill="#F4756B" opacity="0.7"/>
        <circle class="poster-particle poster-particle--2" cx="150" cy="100" r="2.5" fill="#E0B34A" opacity="0.7"/>
        <!-- Title -->
        <text x="300" y="30" text-anchor="middle" fill="#F2F3F5" font-size="16" font-family="monospace">Weft — Live Preview</text>
        <text x="300" y="370" text-anchor="middle" fill="#6B7280" font-size="10" font-family="monospace">Simulated demo · no credentials · no live session</text>
      </svg>
    </div>

    <!-- R3F island (client:only="load" — starts immediately) -->
    <SceneCanvas client:only="load" />

    <!-- Fallback event list (always present for no-JS) -->
    <ol class="evt-fallback" data-agent-events-fallback aria-hidden="false">
      {seedEvents.map((e) => (
        <li class={`evt evt--${e.kind}`} data-evt-kind={e.kind} data-evt-seq={e.seq}>
          <span class="evt-seq">{e.seq}</span>
          <span class="evt-agent">{e.agent}</span>
          <span class="evt-msg">{e.msg}</span>
        </li>
      ))}
    </ol>

    <!-- Live event log (driven by scene) -->
    <ol class="agent-events" data-agent-events aria-label="Live event log" aria-live="polite">
      <!-- Populated by scene via CustomEvent -->
    </ol>

    <!-- Readout -->
    <div class="canvas-readout" role="status" aria-live="polite" data-agent-readout data-sim-label>
      Simulated account · no credentials · no live session
    </div>

  </div>

  <!-- COPY LAYER (z-index:1, floats over the full-bleed scene) -->
  <div class="hero__copy">
    <p class="eyebrow reveal">
      <span class="eyebrow__dot" aria-hidden="true"></span>
      Evidence gate · armed
    </p>
    <h1 class="headline reveal" aria-label="One link. Many agents. All governed.">
      One link. <span class="accent">Many agents.</span> All governed.
    </h1>
    <p class="lede reveal">One link opens a room. Your agents join it, talk in order, and anything stale gets refused.</p>
    <div class="hero-ctas reveal">
      <a class="btn btn-accent group" href={APP_SIGNUP_URL}>
        Open a room
        <span class="btn__icon" aria-hidden="true">→</span>
      </a>
      <a class="btn btn-ghost" href="#how-it-works">See how it works</a>
    </div>
  </div>
</section>

<style>
  /* ============================================================
     FULL-BLEED HERO
     The scene covers the whole section; copy floats on top.
     ============================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    padding: 0;
    background: var(--color-ink);
    color: var(--color-text-inv);
    overflow: hidden;
  }

  /* FULL-BLEED SCENE — covers entire hero section */
  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
  }

  /* Static poster fills the scene */
  .canvas-poster {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* COPY LAYER — floats over the scene */
  .hero__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 5.5rem 2rem 3rem;
    max-width: var(--spacing-shell);
    margin: 0 auto;
    min-height: 100dvh;
    align-items: flex-start;
    justify-content: flex-start;
    padding-top: 18vh;
    pointer-events: none;
    /* Readability floor: strong left-side scrim so glyphs never overlap
       bright scene elements. Text legibility wins over spectacle.
       Funnel lane (2026-08-07): extended the scrim to ~96% so the tail of a
       full-width headline ("All governed.") never sits on the glowing orb
       (verified at 1440x900: 0 bright pixels overlap the headline box). */
    background: linear-gradient(90deg, rgba(5,5,5,0.85) 0%, rgba(5,5,5,0.65) 40%, rgba(5,5,5,0.45) 60%, rgba(5,5,5,0.28) 78%, rgba(5,5,5,0) 96%);
  }
  .hero__copy > * {
    pointer-events: auto;
  }
  /* Left-center anchoring with max-width so it doesn't cover the whole scene */
  .hero__copy .headline {
    max-width: 18ch;
  }
  .hero__copy .lede {
    max-width: 36ch;
  }

  /* Eyebrow badge with pulsing dot */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted-inv);
    margin: 0;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink-3) 60%, transparent);
    border: 1px solid var(--color-hairline-inv);
    align-self: flex-start;
  }
  .eyebrow__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5);
    animation: eyebrow-pulse 2s var(--ease-out) infinite;
    flex-shrink: 0;
  }
  @keyframes eyebrow-pulse {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  /* Massive headline */
  .headline {
    font-size: clamp(2.75rem, 6.5vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
    text-shadow: 0 2px 24px rgba(0,0,0,0.45);
  }
  .accent { color: var(--color-accent-dark); }

  /* Lede */
  .lede {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-text-muted-inv);
    margin: 0;
    text-shadow: 0 1px 12px rgba(0,0,0,0.4);
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn-accent {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .btn-accent:hover {
    background: var(--color-accent-2);
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(91, 61, 240, 0.35);
  }
  .btn__icon {
    display: inline-flex;
    align-items: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn-accent:hover .btn__icon,
  .btn-accent.group:hover .btn__icon {
    transform: translateX(3px);
  }
  .btn-ghost {
    background: rgba(14, 15, 18, 0.55);
    color: var(--color-text-inv);
    border-color: var(--color-hairline-inv);
    backdrop-filter: blur(6px);
  }
  .btn-ghost:hover {
    border-color: var(--color-accent-dark);
    color: var(--color-accent-dark);
    background: rgba(157, 130, 255, 0.1);
  }

  /* Readout */
  .canvas-readout {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    color: var(--color-text-muted-inv);
    font-family: var(--font-mono);
    z-index: 10;
    pointer-events: none;
  }

  /* Event lists */
  .agent-events {
    position: absolute;
    bottom: 2.5rem;
    left: 0.75rem;
    right: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 10;
    max-height: 180px;
    overflow-y: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    pointer-events: none;
  }
  .evt-fallback {
    position: absolute;
    bottom: 2.5rem;
    left: 0.75rem;
    right: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 9;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    pointer-events: none;
  }
  .evt {
    display: flex;
    gap: 0.5rem;
    padding: 0.2rem 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .evt.in {
    opacity: 1;
    transform: none;
  }
  .evt-seq {
    color: var(--color-text-muted-inv);
    min-width: 2rem;
  }
  .evt-agent {
    color: var(--color-accent-dark);
    min-width: 4rem;
  }
  .evt-msg {
    color: var(--color-text-inv);
  }
  .evt--refuse .evt-msg { color: var(--color-refuse); }
  .evt--assert .evt-msg { color: var(--color-assert); }
  .evt--prove .evt-msg { color: var(--color-prove); }
  .evt--join .evt-msg { color: var(--color-success); }

  /* ============================================================
     POSTER FIRST-PAINT ANIMATION
     CSS keyframe animations on the static poster SVG so the hero
     is visibly alive even before WebGL hydrates.
     Only transform/opacity/filter animated.
     ============================================================ */
  .poster-room {
    transform-origin: 300px 200px;
    animation: poster-room-pulse 3.6s ease-in-out infinite;
  }
  @keyframes poster-room-pulse {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 6px rgba(91, 61, 240, 0.6)); }
    50% { transform: scale(1.08); filter: drop-shadow(0 0 18px rgba(157, 130, 255, 0.9)); }
  }

  .poster-agent {
    transform-box: fill-box;
    transform-origin: center;
  }
  .poster-agent--0 { animation: poster-drift-0 7s ease-in-out infinite; }
  .poster-agent--1 { animation: poster-drift-1 9s ease-in-out infinite; }
  .poster-agent--2 { animation: poster-drift-2 8s ease-in-out infinite; }
  .poster-agent--3 { animation: poster-drift-3 10s ease-in-out infinite; }
  .poster-agent--4 { animation: poster-drift-4 7.5s ease-in-out infinite; }

  @keyframes poster-drift-0 {
    0%, 100% { transform: translate(0, 0); opacity: 0.85; }
    50% { transform: translate(8px, -6px); opacity: 1; }
  }
  @keyframes poster-drift-1 {
    0%, 100% { transform: translate(0, 0); opacity: 0.85; }
    50% { transform: translate(-6px, 8px); opacity: 1; }
  }
  @keyframes poster-drift-2 {
    0%, 100% { transform: translate(0, 0); opacity: 0.85; }
    50% { transform: translate(10px, 4px); opacity: 1; }
  }
  @keyframes poster-drift-3 {
    0%, 100% { transform: translate(0, 0); opacity: 0.85; }
    50% { transform: translate(-4px, -10px); opacity: 1; }
  }
  @keyframes poster-drift-4 {
    0%, 100% { transform: translate(0, 0); opacity: 0.85; }
    50% { transform: translate(6px, 6px); opacity: 1; }
  }

  .poster-particle {
    transform-box: fill-box;
    transform-origin: center;
  }
  .poster-particle--0 { animation: poster-orb-0 5s linear infinite; }
  .poster-particle--1 { animation: poster-orb-1 6.5s linear infinite; }
  .poster-particle--2 { animation: poster-orb-2 4.5s linear infinite; }

  @keyframes poster-orb-0 {
    0% { transform: translate(0, 0); opacity: 0.2; }
    25% { transform: translate(60px, -30px); opacity: 0.9; }
    50% { transform: translate(120px, 10px); opacity: 0.6; }
    75% { transform: translate(80px, 50px); opacity: 0.9; }
    100% { transform: translate(0, 0); opacity: 0.2; }
  }
  @keyframes poster-orb-1 {
    0% { transform: translate(0, 0); opacity: 0.3; }
    33% { transform: translate(-40px, 40px); opacity: 0.8; }
    66% { transform: translate(30px, 80px); opacity: 0.5; }
    100% { transform: translate(0, 0); opacity: 0.3; }
  }
  @keyframes poster-orb-2 {
    0% { transform: translate(0, 0); opacity: 0.2; }
    50% { transform: translate(90px, -20px); opacity: 0.9; }
    100% { transform: translate(0, 0); opacity: 0.2; }
  }

  /* ============================================================
     MOBILE (<768px): copy stacks above, scene behind
     ============================================================ */
  @media (max-width: 768px) {
    .hero {
      min-height: 100dvh;
    }
    .hero__scene {
      position: absolute;
      height: 100%;
      min-height: 100%;
    }
    .hero__copy {
      min-height: 100dvh;
      padding: 6rem 1rem 2rem;
      justify-content: flex-start;
      padding-top: 20vh;
      background: linear-gradient(180deg, rgba(5,5,5,0.7) 0%, rgba(5,5,5,0.4) 40%, rgba(5,5,5,0.2) 60%, rgba(5,5,5,0) 100%);
    }
    .headline {
      font-size: clamp(2rem, 9vw, 3rem);
      text-shadow: 0 2px 16px rgba(0,0,0,0.6);
    }
    .lede {
      max-width: 100%;
    }
    .hero__copy .headline {
      max-width: 100%;
    }
    .hero__copy .eyebrow { margin-top: 0; }
  }

  /* Reduced motion: disable all decorative animations */
  @media (prefers-reduced-motion: reduce) {
    .eyebrow__dot,
    .poster-room,
    .poster-agent,
    .poster-particle {
      animation: none;
    }
  }
</style>

<script>
  // DOM bridge listener — subscribes to agent-event CustomEvents
  // and updates the event log, gate state, beat caption, readout.
  (function () {
    const eventsList = document.querySelector('[data-agent-events]');
    const fallbackList = document.querySelector('[data-agent-events-fallback]');
    const readout = document.querySelector('[data-agent-readout]');

    let seqCounter = 6; // After seed events

    function appendEvent(kind, agent, msg, seq) {
      if (!eventsList) return;
      const li = document.createElement('li');
      li.className = 'evt evt--' + kind;
      li.setAttribute('data-evt-kind', kind);
      li.setAttribute('data-evt-seq', String(seq || seqCounter));
      li.innerHTML =
        '<span class="evt-seq">' + String(seq || seqCounter).padStart(3, '0') + '</span>' +
        '<span class="evt-agent">' + agent + '</span>' +
        '<span class="evt-msg">' + msg + '</span>';
      eventsList.appendChild(li);
      // Trigger animation
      requestAnimationFrame(() => li.classList.add('in'));

      // Mirror to fallback
      if (fallbackList) {
        const fbLi = li.cloneNode(true);
        fbLi.classList.add('in');
        fallbackList.appendChild(fbLi);
      }

      // Limit visible rows
      while (eventsList.children.length > 12) {
        eventsList.removeChild(eventsList.firstChild);
      }
    }

    window.addEventListener('agent-event', function (e) {
      const detail = e.detail;
      if (!detail) return;

      if (detail.kind === 'refuse') {
        appendEvent('refuse', detail.agent, detail.msg, detail.seq);
        if (readout) readout.textContent = 'REFUSED: stale fencing token';
      } else if (detail.kind === 'beat') {
        if (readout) readout.textContent = detail.msg || 'Simulated demo · no credentials · no live session';
      } else {
        appendEvent(detail.kind, detail.agent, detail.msg, detail.seq);
      }
    });

  })();
</script>
