---
/**
 * HeroWebGL.astro — Server-rendered hero markup + R3F island mount.
 * Editorial-Split layout: massive typography LEFT, live agent scene RIGHT.
 * Renders full hero copy, static poster SVG, seed events, and the canvas wrap.
 * The R3F island is mounted via client:only="visible".
 */
import SceneCanvas from './scene/SceneCanvas.tsx';

const seedEvents = [
  { seq: '001', kind: 'join', agent: 'agent-a', msg: 'joined the room' },
  { seq: '002', kind: 'join', agent: 'agent-b', msg: 'joined the room' },
  { seq: '003', kind: 'assert', agent: 'agent-a', msg: 'asserted scope: handoff.txt' },
  { seq: '004', kind: 'prove', agent: 'agent-b', msg: 'claimed task (fencing 1812495659374878)' },
  { seq: '005', kind: 'refuse', agent: 'agent-a', msg: 'stale_fencing_token (refused)' },
];

const beatCaptions = [
  'One link.',
  'Many agents join.',
  'They all communicate.',
  'The gate refuses stale work.',
  'Evidence recorded.',
  'Connect your agent.',
];
---

<section class="hero" id="hero" aria-label="Finalisma — live product preview">
  <!-- Editorial split: typography LEFT, scene RIGHT -->
  <div class="hero__grid">

    <!-- LEFT COLUMN: Massive typography -->
    <div class="hero__copy">
      <p class="eyebrow reveal">
        <span class="eyebrow__dot" aria-hidden="true"></span>
        Evidence gate · armed
      </p>
      <h1 class="headline reveal" aria-label="One link. Many agents. All governed.">
        One link.<span class="accent">Many agents.</span>All governed.
      </h1>
      <p class="lede reveal">One link opens a room. Your agents join it, talk in order, and anything stale gets refused.</p>
      <div class="hero-ctas reveal">
        <a class="btn btn-accent group" href="#connect">
          Connect an agent
          <span class="btn__icon" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="/demo.html">Watch the 42-second proof</a>
      </div>
    </div>

    <!-- RIGHT COLUMN: Live agent scene (double-bezel) -->
    <div class="hero__scene">
      <div class="bezel">
        <div class="bezel__core">
          <div class="hero-canvas" data-agent-canvas-wrap>
            <!-- Static poster SVG (always rendered, shown if WebGL fails) -->
            <div class="canvas-poster" data-agent-poster aria-hidden="false">
              <svg viewBox="0 0 600 400" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
                <rect width="600" height="400" fill="#0E0F12"/>
                <!-- Room node (center) -->
                <rect x="270" y="170" width="60" height="60" rx="8" fill="#5B3DF0" opacity="0.8"/>
                <text x="300" y="205" text-anchor="middle" fill="#F2F3F5" font-size="12" font-family="monospace">ROOM</text>
                <!-- Agent nodes -->
                <rect x="100" y="120" width="40" height="40" rx="6" fill="#F4756B" opacity="0.8"/>
                <text x="120" y="145" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">A</text>
                <rect x="80" y="240" width="40" height="40" rx="6" fill="#E0B34A" opacity="0.8"/>
                <text x="100" y="265" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">B</text>
                <rect x="40" y="160" width="40" height="40" rx="6" fill="#5B3DF0" opacity="0.8"/>
                <text x="60" y="185" text-anchor="middle" fill="#F2F3F5" font-size="11" font-family="monospace">C</text>
                <rect x="140" y="60" width="40" height="40" rx="6" fill="#5B3DF0" opacity="0.8"/>
                <text x="160" y="85" text-anchor="middle" fill="#F2F3F5" font-size="11" font-family="monospace">D</text>
                <rect x="50" y="280" width="40" height="40" rx="6" fill="#F4756B" opacity="0.8"/>
                <text x="70" y="305" text-anchor="middle" fill="#0E0F12" font-size="11" font-family="monospace">E</text>
                <!-- Edges -->
                <line x1="140" y1="140" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
                <line x1="120" y1="260" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
                <line x1="80" y1="180" x2="270" y2="200" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
                <line x1="180" y1="80" x2="270" y2="170" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
                <line x1="90" y1="300" x2="270" y2="210" stroke="#9D82FF" stroke-width="1" opacity="0.4"/>
                <!-- Title -->
                <text x="300" y="30" text-anchor="middle" fill="#F2F3F5" font-size="16" font-family="monospace">Finalisma — Live Preview</text>
                <text x="300" y="370" text-anchor="middle" fill="#6B7280" font-size="10" font-family="monospace">Simulated demo · no credentials · no live session</text>
              </svg>
            </div>

            <!-- R3F island (client:only) -->
            <SceneCanvas client:only="visible" />

            <!-- Fallback event list (always present for no-JS) -->
            <ol class="evt-fallback" data-agent-events-fallback aria-hidden="false">
              {seedEvents.map((e) => (
                <li class={`evt evt--${e.kind}`} data-evt-kind={e.kind} data-evt-seq={e.seq}>
                  <span class="evt-seq">{e.seq}</span>
                  <span class="evt-agent">{e.agent}</span>
                  <span class="evt-msg">{e.msg}</span>
                </li>
              ))}
            </ol>

            <!-- Live event log (driven by scene) -->
            <ol class="agent-events" data-agent-events aria-label="Live event log" aria-live="polite">
              <!-- Populated by scene via CustomEvent -->
            </ol>

            <!-- Readout -->
            <div class="canvas-readout" role="status" aria-live="polite" data-agent-readout data-sim-label>
              Simulated account · no credentials · no live session
            </div>

            <!-- Beat caption -->
            <div class="beat-caption" data-beat-caption>One link.</div>

            <!-- Gate -->
            <div class="gate" data-gate>
              <span class="gate-label">Evidence gate</span>
              <span class="gate-state" data-gate-state>armed</span>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ============================================================
     EDITORIAL SPLIT HERO
     Two-column grid: massive typography LEFT, live scene RIGHT.
     ============================================================ */
  .hero {
    position: relative;
    min-height: 100dvh;
    width: 100%;
    padding: 7rem 2rem 3rem;
    background: var(--color-ink);
    color: var(--color-text-inv);
    overflow: hidden;
  }

  /* The editorial split grid */
  .hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    max-width: var(--spacing-shell);
    margin: 0 auto;
    min-height: calc(100dvh - 10rem);
  }

  /* LEFT COLUMN: Typography */
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    z-index: 1;
  }

  /* Eyebrow badge with pulsing dot */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted-inv);
    margin: 0;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-ink-3) 60%, transparent);
    border: 1px solid var(--color-hairline-inv);
    align-self: flex-start;
  }
  .eyebrow__dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5);
    animation: eyebrow-pulse 2s var(--ease-out) infinite;
    flex-shrink: 0;
  }
  @keyframes eyebrow-pulse {
    0% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5); }
    70% { box-shadow: 0 0 0 8px rgba(74, 222, 128, 0); }
    100% { box-shadow: 0 0 0 0 rgba(74, 222, 128, 0); }
  }

  /* Massive headline */
  .headline {
    font-size: clamp(2.75rem, 6.5vw, 6rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .accent { color: var(--color-accent-dark); }

  /* Lede */
  .lede {
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-text-muted-inv);
    max-width: 32ch;
    margin: 0;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.95rem;
    transition:
      transform var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn-accent {
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .btn-accent:hover {
    background: var(--color-accent-2);
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(91, 61, 240, 0.35);
  }
  .btn__icon {
    display: inline-flex;
    align-items: center;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .btn-accent:hover .btn__icon,
  .btn-accent.group:hover .btn__icon {
    transform: translateX(3px);
  }
  .btn-ghost {
    background: transparent;
    color: var(--color-text-inv);
    border-color: var(--color-hairline-inv);
  }
  .btn-ghost:hover {
    border-color: var(--color-accent-dark);
    color: var(--color-accent-dark);
    background: rgba(157, 130, 255, 0.06);
  }

  /* RIGHT COLUMN: Scene */
  .hero__scene {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
  }

  /* Double-bezel frame */
  .bezel {
    position: relative;
    width: 100%;
    max-width: 640px;
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    padding: 12px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.12) 0%,
      rgba(255, 255, 255, 0.04) 50%,
      rgba(157, 130, 255, 0.10) 100%
    );
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .bezel__core {
    width: 100%;
    height: 100%;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-ink-2);
    border: 1px solid rgba(255, 255, 255, 0.06);
    box-shadow: inset 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  /* Canvas wrap fills the bezel core */
  .hero-canvas {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-ink-2);
  }

  /* Static poster */
  .canvas-poster {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Readout */
  .canvas-readout {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 0.7rem;
    color: var(--color-text-muted-inv);
    font-family: var(--font-mono);
    z-index: 10;
    pointer-events: none;
  }

  /* Beat caption */
  .beat-caption {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    z-index: 10;
    pointer-events: none;
  }

  /* Gate */
  .gate {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    z-index: 10;
  }
  .gate-label {
    color: var(--color-text-muted-inv);
  }
  .gate-state {
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: rgba(74, 222, 128, 0.15);
    color: var(--color-success);
    font-weight: 600;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .gate-state[data-state="refuse"],
  .gate.is-refusing .gate-state {
    background: rgba(248, 113, 113, 0.2);
    color: var(--color-refuse);
  }

  /* Event lists */
  .agent-events {
    position: absolute;
    bottom: 2.5rem;
    left: 0.75rem;
    right: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 10;
    max-height: 180px;
    overflow-y: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    pointer-events: none;
  }
  .evt-fallback {
    position: absolute;
    bottom: 2.5rem;
    left: 0.75rem;
    right: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
    z-index: 9;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    pointer-events: none;
  }
  .evt {
    display: flex;
    gap: 0.5rem;
    padding: 0.2rem 0;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.2s;
  }
  .evt.in {
    opacity: 1;
    transform: none;
  }
  .evt-seq {
    color: var(--color-text-muted-inv);
    min-width: 2rem;
  }
  .evt-agent {
    color: var(--color-accent-dark);
    min-width: 4rem;
  }
  .evt-msg {
    color: var(--color-text-inv);
  }
  .evt--refuse .evt-msg { color: var(--color-refuse); }
  .evt--assert .evt-msg { color: var(--color-assert); }
  .evt--prove .evt-msg { color: var(--color-prove); }
  .evt--join .evt-msg { color: var(--color-success); }

  /* ============================================================
     MOBILE COLLAPSE (<768px): single column, scene below typography
     ============================================================ */
  @media (max-width: 768px) {
    .hero {
      padding: 6rem 1rem 2rem;
      min-height: auto;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      min-height: auto;
    }
    .hero__copy {
      gap: 1rem;
    }
    .headline {
      font-size: clamp(2.25rem, 10vw, 3.5rem);
    }
    .lede {
      max-width: 100%;
    }
    .hero__scene {
      min-height: 320px;
      width: 100%;
    }
    .bezel {
      max-width: 100%;
      aspect-ratio: 4 / 3;
      border-radius: 16px;
      padding: 8px;
    }
    .bezel__core {
      border-radius: 10px;
    }
  }

  /* Reduced motion: disable pulse animations */
  @media (prefers-reduced-motion: reduce) {
    .eyebrow__dot {
      animation: none;
    }
  }
</style>

<script>
  // DOM bridge listener — subscribes to agent-event CustomEvents
  // and updates the event log, gate state, beat caption, readout.
  (function () {
    const eventsList = document.querySelector('[data-agent-events]');
    const fallbackList = document.querySelector('[data-agent-events-fallback]');
    const gateState = document.querySelector('[data-gate-state]');
    const gateEl = document.querySelector('[data-gate]');
    const beatCaption = document.querySelector('[data-beat-caption]');
    const readout = document.querySelector('[data-agent-readout]');

    const beatCaptions = [
      'One link.',
      'Many agents join.',
      'They all communicate.',
      'The gate refuses stale work.',
      'Evidence recorded.',
      'Connect your agent.',
    ];

    let seqCounter = 6; // After seed events

    function appendEvent(kind, agent, msg, seq) {
      if (!eventsList) return;
      const li = document.createElement('li');
      li.className = 'evt evt--' + kind;
      li.setAttribute('data-evt-kind', kind);
      li.setAttribute('data-evt-seq', String(seq || seqCounter));
      li.innerHTML =
        '<span class="evt-seq">' + String(seq || seqCounter).padStart(3, '0') + '</span>' +
        '<span class="evt-agent">' + agent + '</span>' +
        '<span class="evt-msg">' + msg + '</span>';
      eventsList.appendChild(li);
      // Trigger animation
      requestAnimationFrame(() => li.classList.add('in'));

      // Mirror to fallback
      if (fallbackList) {
        const fbLi = li.cloneNode(true);
        fbLi.classList.add('in');
        fallbackList.appendChild(fbLi);
      }

      // Limit visible rows
      while (eventsList.children.length > 12) {
        eventsList.removeChild(eventsList.firstChild);
      }
    }

    window.addEventListener('agent-event', function (e) {
      const detail = e.detail;
      if (!detail) return;

      if (detail.kind === 'refuse') {
        appendEvent('refuse', detail.agent, detail.msg, detail.seq);
        // Update gate state
        if (gateState) {
          gateState.textContent = 'REFUSED: stale fencing token';
          gateState.setAttribute('data-state', 'refuse');
        }
        if (gateEl) {
          gateEl.classList.add('is-refusing');
          setTimeout(() => gateEl.classList.remove('is-refusing'), 600);
        }
        if (readout) readout.textContent = 'REFUSED: stale fencing token';
      } else if (detail.kind === 'beat') {
        if (beatCaption && beatCaptions[detail.beat - 1]) {
          beatCaption.textContent = beatCaptions[detail.beat - 1];
        }
        if (readout) readout.textContent = detail.msg || 'Simulated demo · no credentials · no live session';
      } else {
        appendEvent(detail.kind, detail.agent, detail.msg, detail.seq);
      }
    });

    // Click gate to trigger refusal
    if (gateEl) {
      gateEl.addEventListener('click', function () {
        if (window.FinalismaScene && typeof window.FinalismaScene.fireGateRefusal === 'function') {
          window.FinalismaScene.fireGateRefusal();
        }
      });
      gateEl.style.cursor = 'pointer';
    }
  })();
</script>
