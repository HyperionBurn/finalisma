---
/**
 * Header.astro — Fluid island nav.
 * Detached floating glass pill (NOT edge-to-edge).
 * Hamburger morphs into X on open.
 * Mobile overlay: full-screen blur + staggered link entrance.
 * Magnetic island CTA: button-in-button with btn__icon arrow.
 * Scrolled state via rAF-throttled passive listener.
 * All harness hooks preserved: data-header, .nav-toggle, #mobile-nav,
 * .mobile-close, nav-links (5 anchors), CTA + Log in, inert handling.
 * Funnel lane (2026-08-07): primary CTA is a real app link ("Open a room" →
 * /app/signup), returning users get a quiet "Log in" affordance.
 */
import { APP_LOGIN_URL, APP_SIGNUP_URL } from '../lib/app';
---

<header class="site-header" data-header>
  <a class="brand" href="/">FINALISMA</a>
  <nav class="nav-links" aria-label="Primary">
    <a href="#problem">Problem</a>
    <a href="#how-it-works">How it works</a>
    <a href="#demo">Live demo</a>
    <a href="#connect">Connect</a>
    <a href="#pricing">Pricing</a>
  </nav>
  <a class="nav-login" href={APP_LOGIN_URL}>Log in</a>
  <a class="btn btn-accent group" href={APP_SIGNUP_URL}>
    Open a room
    <span class="btn__icon" aria-hidden="true">→</span>
  </a>
  <button class="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
    <span></span>
    <span></span>
    <span></span>
  </button>
</header>

<!-- Mobile nav overlay -->
<div class="mobile-nav" id="mobile-nav" aria-hidden="true" data-mobile-nav inert>
  <button class="mobile-close" aria-label="Close menu">&times;</button>
  <nav aria-label="Mobile">
    <a href="#problem">Problem</a>
    <a href="#how-it-works">How it works</a>
    <a href="#demo">Live demo</a>
    <a href="#connect">Connect</a>
    <a href="#pricing">Pricing</a>
    <a class="nav-login" href={APP_LOGIN_URL}>Log in</a>
    <a class="btn btn-accent group" href={APP_SIGNUP_URL}>
      Open a room
      <span class="btn__icon" aria-hidden="true">→</span>
    </a>
  </nav>
</div>

<script>
  // Mobile nav toggle + scroll state
  (function () {
    const header = document.querySelector('[data-header]');
    const toggle = document.querySelector('.nav-toggle');
    const mobileNav = document.getElementById('mobile-nav');
    const closeBtn = document.querySelector('.mobile-close');

    function openNav() {
      if (!mobileNav || !toggle) return;
      mobileNav.classList.add('is-open');
      mobileNav.setAttribute('aria-hidden', 'false');
      mobileNav.inert = false;
      toggle.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeNav() {
      if (!mobileNav || !toggle) return;
      mobileNav.classList.remove('is-open');
      mobileNav.setAttribute('aria-hidden', 'true');
      mobileNav.inert = true;
      toggle.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeNav();
      else openNav();
    });

    closeBtn?.addEventListener('click', closeNav);

    // Close on anchor click
    mobileNav?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', closeNav);
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeNav();
    });

    // Scrolled state via rAF-throttled passive listener (NEVER raw scroll handler)
    let ticking = false;
    function updateHeaderState() {
      if (header) {
        if (window.scrollY > 20) {
          header.classList.add('is-scrolled');
        } else {
          header.classList.remove('is-scrolled');
        }
      }
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateHeaderState);
        ticking = true;
      }
    }, { passive: true });
    updateHeaderState();
  })();
</script>

<style>
  /* ============================================================
     Fluid island: detached floating glass pill
     ============================================================ */
  :global(.site-header) {
    position: fixed;
    top: 1.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
    width: max-content;
    max-width: calc(100vw - 2rem);
    border-radius: 9999px;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: rgba(5, 5, 5, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.10);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    transition:
      background var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      box-shadow var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      padding var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      transform var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }

  /* Scrolled state: slightly more opaque + smaller padding */
  :global(.site-header.is-scrolled) {
    background: rgba(5, 5, 5, 0.78);
    padding: 0.35rem 0.6rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
  }

  /* ============================================================
     Magnetic island CTA: button-in-button with btn__icon
     ============================================================ */
  :global(.site-header .btn-accent) {
    border-radius: 9999px;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    gap: 0.5rem;
    flex-shrink: 0;
    transition:
      transform var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      background var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      box-shadow var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.site-header .btn-accent:active) {
    transform: scale(0.98);
  }
  :global(.site-header .btn-accent .btn__icon) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.18);
    font-size: 0.9rem;
    line-height: 1;
    flex-shrink: 0;
    transition:
      transform var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      background var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.site-header .btn-accent:hover .btn__icon) {
    transform: translateX(3px) scale(1.06);
    background: rgba(255, 255, 255, 0.28);
  }

  /* Quiet "Log in" affordance for returning users */
  :global(.nav-login) {
    color: var(--color-text-muted-inv, #A6AAB4);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.4rem 0.6rem;
    border-radius: 9999px;
    flex-shrink: 0;
    transition:
      color var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      background var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.nav-login:hover) {
    color: var(--color-text-inv, #F2F3F5);
    background: rgba(255, 255, 255, 0.06);
  }

  /* ============================================================
     Hamburger toggle — three lines that morph into X
     ============================================================ */
  :global(.nav-toggle) {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 9999px;
    flex-shrink: 0;
  }
  :global(.nav-toggle span) {
    display: block;
    position: absolute;
    left: 50%;
    width: 22px;
    height: 2px;
    background: var(--color-text-inv, #F2F3F5);
    border-radius: 2px;
    transform: translateX(-50%);
    transition:
      transform var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  /* Three stacked bars (closed state) */
  :global(.nav-toggle span:nth-child(1)) { top: 14px; }
  :global(.nav-toggle span:nth-child(2)) { top: 21px; }
  :global(.nav-toggle span:nth-child(3)) { top: 28px; }
  /* Morph to X (open state) */
  :global(.nav-toggle.is-open span:nth-child(1)) {
    top: 21px;
    transform: translateX(-50%) rotate(45deg);
  }
  :global(.nav-toggle.is-open span:nth-child(2)) {
    opacity: 0;
  }
  :global(.nav-toggle.is-open span:nth-child(3)) {
    top: 21px;
    transform: translateX(-50%) rotate(-45deg);
  }

  /* ============================================================
     Mobile overlay — full-screen blur + staggered entrance
     ============================================================ */
  :global(.mobile-nav) {
    position: fixed;
    inset: 0;
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem;
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    background: rgba(0, 0, 0, 0.8);
    /* Hidden by default unless .is-open */
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition:
      opacity var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      visibility var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.mobile-nav.is-open) {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }
  :global(.mobile-nav nav) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
  }
  /* Staggered link entrance */
  :global(.mobile-nav a) {
    color: var(--color-text-inv, #F2F3F5);
    text-decoration: none;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    text-align: center;
    transform: translateY(3rem);
    opacity: 0;
    transition:
      transform var(--dur-slow, 600ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1)),
      opacity var(--dur-mid, 300ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.mobile-nav.is-open a:nth-child(1)) {
    transition-delay: 100ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(2)) {
    transition-delay: 150ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(3)) {
    transition-delay: 200ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(4)) {
    transition-delay: 250ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(5)) {
    transition-delay: 300ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(6)) {
    transition-delay: 350ms;
    transform: translateY(0);
    opacity: 1;
  }
  :global(.mobile-nav.is-open a:nth-child(7)) {
    transition-delay: 400ms;
    transform: translateY(0);
    opacity: 1;
  }
  /* Close button */
  :global(.mobile-close) {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: none;
    border: none;
    color: var(--color-text-inv, #F2F3F5);
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 9999px;
    transition: background var(--dur-fast, 150ms) var(--ease-out, cubic-bezier(0.22, 1, 0.36, 1));
  }
  :global(.mobile-close:hover) {
    background: rgba(255, 255, 255, 0.08);
  }
  /* Mobile CTA in overlay */
  :global(.mobile-nav .btn-accent) {
    margin-top: 1rem;
    border-radius: 9999px;
    padding: 0.75rem 1rem 0.75rem 1.5rem;
    font-size: 1.1rem;
  }
  :global(.mobile-nav .btn-accent .btn__icon) {
    width: 32px;
    height: 32px;
    font-size: 1rem;
  }
  :global(.mobile-nav .nav-login) {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-muted-inv, #A6AAB4);
    letter-spacing: 0.04em;
  }

  /* ============================================================
     Responsive: show hamburger + overlay on small screens
     ============================================================ */
  @media (max-width: 768px) {
    :global(.site-header) {
      top: 1rem;
      width: calc(100vw - 2rem);
      max-width: calc(100vw - 2rem);
    }
    :global(.nav-links) { display: none; }
    :global(.site-header .btn-accent) { display: none; }
    :global(.site-header .nav-login) { display: none; }
    :global(.nav-toggle) { display: block; }
  }

  /* Reduced motion: disable stagger + morph transitions */
  @media (prefers-reduced-motion: reduce) {
    :global(.mobile-nav a) {
      transform: none;
      transition-duration: 0.01ms;
    }
    :global(.nav-toggle span) {
      transition-duration: 0.01ms;
    }
  }
</style>
