---
/**
 * Marquee.astro — Honest MCP-protocol compatibility band.
 * States which hosts speak the MCP protocol. No endorsement/partnership claim.
 */
---

<section class="marquee" aria-label="MCP-protocol host compatibility">
  <div class="marquee__head">
    <h2 class="marquee__title">Speaks MCP — the protocol these hosts already use</h2>
  </div>
  <div class="marquee__track" data-marquee-track>
    <ul class="marquee__items">
      <li>Claude Code</li>
      <li>Cursor</li>
      <li>Zed</li>
      <li>VS Code</li>
      <li>Continue</li>
      <li>Cline</li>
      <li>Gemini CLI</li>
      <li>OpenCode</li>
    </ul>
    <ul class="marquee__items" aria-hidden="true">
      <li>Claude Code</li>
      <li>Cursor</li>
      <li>Zed</li>
      <li>VS Code</li>
      <li>Continue</li>
      <li>Cline</li>
      <li>Gemini CLI</li>
      <li>OpenCode</li>
    </ul>
  </div>
  <p class="marquee__note">MCP is a public protocol; these names identify the hosts that speak it.</p>
</section>

<style>
  .marquee {
    padding-block: clamp(28px, 4vw, 56px);
    background: var(--surface);
    border-block: 1px solid var(--hairline);
  }
  .marquee__head {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    margin-bottom: 1rem;
  }
  .marquee__title {
    font-family: var(--display);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0;
  }
  .marquee__track {
    display: flex;
    overflow-x: clip;
    white-space: nowrap;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  .marquee__items {
    display: flex;
    flex-shrink: 0;
    gap: clamp(2rem, 5vw, 4rem);
    margin: 0;
    padding: 0;
    list-style: none;
    padding-inline-end: clamp(2rem, 5vw, 4rem);
    animation: marquee-scroll 30s linear infinite;
  }
  .marquee__items li {
    font-family: var(--display);
    font-size: clamp(0.7rem, 1.2vw, 0.85rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .marquee:hover .marquee__items {
    animation-play-state: paused;
  }
  .marquee__note {
    max-width: var(--shell);
    margin-inline: auto;
    padding-inline: var(--pad);
    margin-top: 1rem;
    margin-bottom: 0;
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__items {
      animation: none !important;
    }
    .marquee__track {
      flex-wrap: wrap;
      gap: 0.5rem 2rem;
      justify-content: center;
      mask-image: none;
      -webkit-mask-image: none;
      white-space: normal;
    }
    .marquee__items {
      flex-shrink: 1;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 2rem;
      animation: none !important;
    }
  }
</style>
