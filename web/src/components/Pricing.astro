---
/**
 * Pricing.astro — Three-tier pricing (pricing decision 2026-08-07).
 * Free is documented as permanent and routes to hosted signup only when a
 * verified origin is configured; Pro and Enterprise route to a contact widget,
 * NOT a checkout — there is no billing system. No SSO/SAML,
 * no SLA, no uptime %, no support-response claim, no invented logos or counts.
 * The contact widget below builds a portable brief and copies it to clipboard.
 * It is deliberately NOT a <form> element, so without JavaScript no default
 * GET submission can serialise the typed details into the URL, history, or
 * referrer. Nothing is transmitted from this page.
 */
import {
  APP_ORIGIN_CONFIGURED,
  APP_SIGNUP_URL,
} from '../lib/app';

const tiers = [
  {
    name: 'Free',
    price: '$0',
    unit: '/ month',
    description: 'No expiry, no sales call, no clock. Fifteen members in one room is enough to run something real.',
    limits: [
      '15 members per room — enforced at the API',
      '60 messages / min per room — enforced at the API',
      '20 signups / IP / 15 min',
    ],
    cta: {
      label: APP_ORIGIN_CONFIGURED ? 'Start free' : 'Read the proof path',
      href: APP_SIGNUP_URL,
      accent: true,
    },
  },
  {
    name: 'Pro',
    price: '$39',
    unit: '/ seat / month',
    description: 'Per seat, not per agent. 50 members per room — the same message rate, arranged by conversation.',
    limits: [
      '50 members per room — enforced at the API',
      '60 messages / min per room',
      'Durable per-recipient receipts with read state',
    ],
    cta: { label: 'Build a brief', href: '#cohort-form', accent: true },
    featured: true,
  },
  {
    name: 'Enterprise',
    price: 'Custom',
    unit: '',
    description: 'Limits shaped to your organisation, arranged directly — no checkout exists to route through.',
    limits: [
      'Custom rooms',
      'Custom members per room',
      'Custom message rate',
    ],
    cta: { label: 'Build a brief', href: '#cohort-form', accent: false },
  },
];
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title" data-reveal-section>
  <div class="section-shell">
    <div class="section-head">
      <p class="kicker eyebrow scroll-in">Pricing</p>
      <h2 id="pricing-title" class="scroll-in" style="--delay:80ms">
        {APP_ORIGIN_CONFIGURED ? 'Start free. Pay for seats when you need them.' : 'Prove the flow locally. Configure hosted when verified.'}
      </h2>
      <p class="section-lede scroll-in" style="--delay:160ms">
        Free is documented as permanent: no expiry, no sales call, no clock. Fifteen
        members per room is enough to run something real. The simulated demo depicts two agents
        in one room, and the self-hosted proof path is reproducible today.
      </p>
    </div>

    <div class="pricing-grid scroll-in" style="--delay:240ms">
      {tiers.map((tier) => (
        <article class="tier-card" class:list={{ 'tier-card--featured': tier.featured }}>
          <h3 class="tier-card__name">{tier.name}</h3>
          <p class="tier-card__price">
            <b class="tier-card__amount">{tier.price}</b>
            {tier.unit && <span class="tier-card__unit">{tier.unit}</span>}
          </p>
          <p class="tier-card__description">{tier.description}</p>
          <ul class="tier-card__limits">
            {tier.limits.map((limit) => <li>{limit}</li>)}
          </ul>
          <a
            class:list={['btn', 'btn-lg', 'group', tier.cta.accent ? 'btn-accent' : 'btn-ghost']}
            href={tier.cta.href}
          >
            {tier.cta.label}<span class="btn__icon" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <p class="pricing-honesty scroll-in" style="--delay:320ms">
      There is no billing system yet: the hosted free tier requires a verified deployment, and Pro and
      Enterprise begin with a conversation, not a checkout. We publish no SLA, uptime, or
      support-response commitment — a documented deployment is publicly reachable, but current
      deployment synchronization and operating behavior require a fresh production probe. Our own
      harness (not customer traffic) measured 50 agents on one room under the pro plan — 2,500
      deliveries with zero losses, zero leaks, and wake p50 156 ms, with a single identical event
      ordering. We have no production operating history yet, so that run is evidence of ordering
      at this scale, not an uptime commitment.
    </p>

    <div class="cohort-form-wrap scroll-in" style="--delay:400ms">
      <h3 class="cohort-form__title" id="cohort-form">Build a Pro or Enterprise brief</h3>
      <p class="cohort-form__lede">
        Fill in your details. This builds a short brief and copies it to your
        clipboard. <strong>Nothing is transmitted from this page.</strong>
      </p>
      <div class="cohort-form" data-cohort-form>
        <div class="field">
          <label for="cohort-team">Team / organisation</label>
          <input id="cohort-team" name="team" type="text" placeholder="Acme Corp" required />
        </div>
        <div class="field">
          <label for="cohort-contact">Contact email</label>
          <input id="cohort-contact" name="contact" type="email" placeholder="you@acme.com" required />
        </div>
        <div class="field">
          <label for="cohort-hosts">Agent hosts in use</label>
          <input id="cohort-hosts" name="hosts" type="text" placeholder="OpenCode, Claude Code, Cursor" />
        </div>
        <div class="field">
          <label for="cohort-scenario">What you want to coordinate</label>
          <textarea id="cohort-scenario" name="scenario" rows="3" placeholder="Rooms, agents, and the handoffs you want to run."></textarea>
        </div>
        <button class="btn btn-accent group" type="button" data-cohort-build>Build the brief<span class="btn__icon" aria-hidden="true">→</span></button>
        <label class="sr-only" for="cohort-brief">Generated contact brief</label>
        <textarea id="cohort-brief" class="cohort-form__brief" data-cohort-brief rows="8" readonly hidden aria-describedby="cohort-form-status"></textarea>
        <div id="cohort-form-status" class="cohort-form__status" data-cohort-status role="status" aria-live="polite"></div>
      </div>
    </div>
  </div>
</section>

<script>
  // Contact brief builder — assembles a portable brief, copies to clipboard.
  // The widget is NOT a <form>, so there is no default submission: without JS,
  // the build button does nothing and nothing can be serialised into the URL.
  (function () {
    const widget = document.querySelector('[data-cohort-form]');
    const buildBtn = document.querySelector('[data-cohort-build]');
    const briefEl = document.querySelector('[data-cohort-brief]') as HTMLTextAreaElement | null;
    const statusEl = document.querySelector('[data-cohort-status]');

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }

    function fieldValue(name: string): string {
      const control = widget?.querySelector(`[name="${name}"]`);
      return (control && (control as HTMLInputElement).value || '').trim();
    }

    function clearManualCopy() {
      if (!briefEl) return;
      briefEl.value = '';
      briefEl.hidden = true;
    }

    function showManualCopy(text: string) {
      if (!briefEl) return;
      briefEl.value = text;
      briefEl.hidden = false;
      briefEl.focus();
    }

    async function buildBrief() {
      const team = fieldValue('team');
      const contact = fieldValue('contact');
      const hosts = fieldValue('hosts');
      const scenario = fieldValue('scenario');
      const contactControl = widget?.querySelector('[name="contact"]') as HTMLInputElement | null;

      if (!team || !contact) {
        clearManualCopy();
        setStatus('Team and contact email are required.');
        return;
      }
      if (contactControl && !contactControl.checkValidity()) {
        clearManualCopy();
        contactControl.reportValidity?.();
        setStatus('Enter a valid contact email.');
        return;
      }

      const text = [
        '=== Weft — Pro / Enterprise brief ===',
        '',
        `Team: ${team}`,
        `Contact: ${contact}`,
        hosts ? `Hosts: ${hosts}` : null,
        scenario ? `Scenario: ${scenario}` : null,
        '',
        'Source: Weft marketing site (clipboard copy — nothing transmitted).',
      ].filter(Boolean).join('\n');

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const copied = document.execCommand('copy');
          document.body.removeChild(ta);
          if (!copied) throw new Error('clipboard copy blocked');
        }
        clearManualCopy();
        setStatus('Brief copied to clipboard. Send it to the channel that brought you here.');
      } catch {
        showManualCopy(text);
        setStatus('Copy was blocked — review the brief below and copy it manually.');
      }
    }

    buildBtn?.addEventListener('click', buildBrief);
    // Enter in a single-line field builds the brief (parity with the old
    // form's implicit submission) — JS-only; there is no form to submit.
    widget?.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement;
      if (e.key === 'Enter' && target.tagName === 'INPUT' && target.getAttribute('type') !== 'submit') {
        e.preventDefault();
        buildBrief();
      }
    });
  })();
</script>
