---
/**
 * Pricing.astro — Pricing hypothesis + cohort application form.
 * The form builds a portable application text and copies to clipboard.
 * Nothing is transmitted from this page.
 */
---

<section class="section pricing" id="pricing" aria-labelledby="pricing-title" data-reveal-section>
  <div class="section-shell">
    <div class="section-head">
      <p class="kicker eyebrow scroll-in">Pricing</p>
      <h2 id="pricing-title" class="scroll-in" style="--delay:80ms">Tested with design partners.</h2>

    </div>

    <div class="bezel scroll-in" style="--delay:160ms">
      <div class="bezel__core pricing-card">
        <p class="pricing-hypothesis">Hypothesis, tested with design partners:</p>
        <p class="pricing-figure"><b>$1,000</b> / workspace / month</p>
        <p class="pricing-deposit"><b>$500 deposit</b> credited toward the first month.</p>
        <p class="pricing-pilot">30-day free pilot.</p>
        <div class="pricing-ctas">
          <a class="btn btn-accent btn-lg group" href="#connect">Connect an agent<span class="btn__icon" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost group" href="/docs/pilot.html">Apply for the managed pilot<span class="btn__icon" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>

    <div class="cohort-form-wrap scroll-in" style="--delay:240ms">
      <h3 class="cohort-form__title">Build the application</h3>
      <p class="cohort-form__lede">
        Fill in your details. The form builds an application text
        and copies it to your clipboard. <strong>Nothing is transmitted from this page.</strong>
      </p>
      <form class="cohort-form" data-cohort-form id="cohort-form">
        <div class="field">
          <label for="cohort-team">Team / organisation</label>
          <input id="cohort-team" name="team" type="text" placeholder="Acme Corp" required />
        </div>
        <div class="field">
          <label for="cohort-contact">Contact email</label>
          <input id="cohort-contact" name="contact" type="email" placeholder="you@acme.com" required />
        </div>
        <div class="field">
          <label for="cohort-hosts">Agent hosts in use</label>
          <input id="cohort-hosts" name="hosts" type="text" placeholder="OpenCode, Claude Code, Cursor" />
        </div>
        <div class="field">
          <label for="cohort-scenario">Coordination scenario</label>
          <textarea id="cohort-scenario" name="scenario" rows="3" placeholder="Two agents, one handoff task, evidence-gated completion."></textarea>
        </div>
        <button class="btn btn-accent group" type="submit">Build the application<span class="btn__icon" aria-hidden="true">→</span></button>
        <div class="cohort-form__status" data-cohort-status role="status" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<script>
  // Cohort form — builds portable application text, copies to clipboard, no transmission
  (function () {
    const form = document.getElementById('cohort-form') as HTMLFormElement | null;
    const statusEl = document.querySelector('[data-cohort-status]');

    function setStatus(msg: string) {
      if (statusEl) statusEl.textContent = msg;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const team = (data.get('team') as string || '').trim();
      const contact = (data.get('contact') as string || '').trim();
      const hosts = (data.get('hosts') as string || '').trim();
      const scenario = (data.get('scenario') as string || '').trim();

      if (!team || !contact) {
        setStatus('Team and contact email are required.');
        return;
      }

      const text = [
        '=== Finalisma Managed Pilot Application ===',
        '',
        `Team: ${team}`,
        `Contact: ${contact}`,
        hosts ? `Hosts: ${hosts}` : null,
        scenario ? `Scenario: ${scenario}` : null,
        '',
        'Generated: ' + new Date().toISOString(),
        'Source: Finalisma marketing site (clipboard copy — nothing transmitted).',
      ].filter(Boolean).join('\n');

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
        } else {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          document.execCommand('copy');
          document.body.removeChild(ta);
        }
        setStatus('Application copied to clipboard. Paste it into an email to apply.');
      } catch {
        setStatus('Copy failed — select and copy the text manually.');
      }
    });
  })();
</script>
