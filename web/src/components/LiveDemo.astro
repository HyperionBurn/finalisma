---
/**
 * LiveDemo.astro — Terminal output, generated link, gate refusal.
 * The full terminal is server-rendered for no-JS / a11y; a client script
 * typewriter-reveals it on scroll-in (skipped under prefers-reduced-motion).
 */

const terminalLines = [
  '$ python -B scripts/weft-mcp.py --transport stdio --team-id demo',
  'weft-mcp/0.1.0 ready · 58 tools · protocol 2025-11-25',
  '',
  '> register_agent(team_id="demo", agent_id="agent-a", role="architect")',
  '  → {"agent_id": "agent-a", "status": "active", "actor_token": "fst_***"}',
  '',
  '> claim_task(..., fencing_token=0)',
  '  → <span class="terminal__refuse">REFUSED: stale fencing token</span>',
];

const terminalText = terminalLines.join('\n');
---

<section class="section demo" id="demo" aria-labelledby="demo-title" data-reveal-section>
  <div class="section-shell">
    <div class="section-head">
      <p class="kicker eyebrow scroll-in">Demo</p>
      <h2 id="demo-title" class="scroll-in" style="--delay:80ms">See it run.</h2>
      <p class="section-lede scroll-in" style="--delay:160ms">
        A real coordinator run — simulated here with real protocol strings.
        Watch an agent register and the evidence gate refuse stale work.
      </p>
    </div>

    <div class="bezel scroll-in" style="--delay:240ms">
      <div class="bezel__core demo-shell" data-demo-shell>
        <pre class="terminal is-typewriter" data-terminal role="log" aria-live="polite" data-full={terminalText}><code set:html={terminalText}></code><span class="terminal__caret" aria-hidden="true"></span></pre>

        <p class="section-lede" style="margin-top:1rem">Banner: the <strong>self-hosted</strong> coordinator advertises 58 tools. The hosted <code>POST /mcp</code> endpoint exposes 11 — the room set under Connect.</p>

        <div class="demo-output">
          <div class="link-out" data-link-output>
            <span class="link-out__label">Room link</span>
            <code class="link-out__code" data-generated-link>weft.test/r/room_8cc840e0fd9044b7ab2154af9e9c1222</code>
            <button class="btn btn-sm group" data-copy="link" type="button">Copy link<span class="btn__icon" aria-hidden="true">→</span></button>
          </div>
          <div class="gate" data-gate>
            <span class="gate-label">Evidence gate</span>
            <span class="gate-state" data-gate-state>armed</span>
            <button class="btn btn-sm btn-ghost group" data-trigger-refusal type="button">Trigger refusal<span class="btn__icon" aria-hidden="true">→</span></button>
          </div>
          <div class="copy-status" aria-live="polite" data-copy-status></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .terminal.is-typewriter { position: relative; }
  .terminal__caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    vertical-align: -0.15em;
    background: currentColor;
    opacity: 0;
    margin-left: 0.1ch;
  }
  .terminal.is-typing .terminal__caret { opacity: 1; animation: weft-blink 1s steps(1) infinite; }
  .terminal.is-done .terminal__caret { opacity: 0; }
  @keyframes weft-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .terminal__caret { display: none !important; }
  }
</style>

<script>
  // Copy to clipboard + gate trigger + terminal typewriter
  (function () {
    const copyBtn = document.querySelector('[data-copy="link"]');
    const codeEl = document.querySelector('[data-generated-link]');
    const statusEl = document.querySelector('[data-copy-status]');
    const gateState = document.querySelector('[data-gate-state]');
    const gateEl = document.querySelector('[data-gate]');
    const triggerBtn = document.querySelector('[data-trigger-refusal]');

    function setStatus(msg) {
      if (statusEl) statusEl.textContent = msg;
    }

    async function copyText(text) {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          setStatus('Copied to clipboard.');
          return;
        }
      } catch {}
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        setStatus('Copied to clipboard.');
      } catch {
        setStatus('Copy failed — select and copy manually.');
      }
    }

    copyBtn?.addEventListener('click', () => {
      const text = codeEl?.textContent?.trim() || '';
      copyText(text);
      copyBtn.classList.add('is-copied');
      setTimeout(() => copyBtn.classList.remove('is-copied'), 1500);
    });

    function fireRefusal() {
      if (gateState) {
        gateState.textContent = 'REFUSED: stale fencing token';
        gateState.setAttribute('data-state', 'refuse');
      }
      if (gateEl) {
        gateEl.classList.add('is-refusing');
        setTimeout(() => gateEl.classList.remove('is-refusing'), 600);
      }
      setStatus('Gate refused: stale fencing token.');
      setTimeout(() => {
        if (gateState) {
          gateState.textContent = 'armed';
          gateState.removeAttribute('data-state');
        }
      }, 3000);
    }

    triggerBtn?.addEventListener('click', () => {
      if ((window as any).WeftScene?.fireGateRefusal) {
        (window as any).WeftScene.fireGateRefusal();
      } else {
        fireRefusal();
      }
    });

    // Typewriter reveal on scroll-in.
    const terminal = document.querySelector('[data-terminal]');
    if (terminal) {
      const full = terminal.getAttribute('data-full') || '';
      const reduced =
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduced || !('IntersectionObserver' in window)) {
        // Full text already rendered in the <code>; nothing to do.
        terminal.classList.add('is-done');
        return;
      }

      // Hide text immediately via JS; reveal line by line on intersection.
      const code = terminal.querySelector('code');
      if (code) code.textContent = '';
      terminal.classList.add('is-typing');

      const lines = full.split('\n');
      let lineIdx = 0;
      let timer: number | undefined;

      function typeNext() {
        if (lineIdx >= lines.length) {
          terminal.classList.remove('is-typing');
          terminal.classList.add('is-done');
          return;
        }
        const cur = lines[lineIdx];
        // Append the line (preserve the innerHTML of the refuse line).
        if (lineIdx > 0) code!.appendChild(document.createTextNode('\n'));
        // The refuse line contains an inner <span>; render via a temp node.
        if (cur.includes('<span')) {
          const tmp = document.createElement('span');
          tmp.innerHTML = cur;
          while (tmp.firstChild) code!.appendChild(tmp.firstChild);
        } else {
          code!.appendChild(document.createTextNode(cur));
        }
        lineIdx += 1;
        timer = window.setTimeout(typeNext, 160);
      }

      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              timer = window.setTimeout(typeNext, 200);
            }
          }
        },
        { threshold: 0.25 }
      );
      io.observe(terminal);
    }
  })();
</script>
