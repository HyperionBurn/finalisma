---
/**
 * ConnectTiers.astro — Four connection tiers as switchable copy-paste config blocks.
 * Real config strings from INTEROP docs.
 */

const tiers = [
  {
    id: 'stdio',
    label: 'MCP stdio',
    code: `{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "finalisma": {
      "type": "local",
      "command": ["python", "-B", "scripts/finalisma-mcp.py",
        "--transport", "stdio", "--team-id", "demo",
        "--workspace", "./ws",
        "--state", "./ws/.finalisma/state.db"],
      "enabled": true,
      "timeout": 10000
    }
  }
}`,
  },
  {
    id: 'http',
    label: 'Streamable HTTP',
    code: `POST /mcp HTTP/1.1
Host: 127.0.0.1:18787
Content-Type: application/json
Authorization: Bearer &lt;actor_token&gt;
Team: &lt;tenant_id&gt;

{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{}}}

# Response:
# {"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-11-25",
#   "serverInfo":{"name":"finalisma-mcp","version":"0.1.0"}}}`,
  },
  {
    id: 'bridge',
    label: 'Bridge adapters',
    code: `from finalisma_mcp.bridge import ClipboardBridge, PollingBridge, WebhookBridge

# Clipboard: one-shot bootstrap snippet
clipboard = ClipboardBridge(coordinator_db=db)
snippet = clipboard.generate_bootstrap(pairing_id="pair_...", nonce="d67ec2fe...")
# 2nd parse refused: "Bootstrap snippet has already been consumed"

# Polling: at-most-once cursor delivery
polling = PollingBridge(coordinator_db=db)
events = polling.get_pending(agent_id="agent-a", token="fst_...", cursor=0)
polling.ack(agent_id="agent-a", cursor=1)
# wrong token refused: "Actor token mismatch"

# Webhook: HMAC-signed delivery
webhook = WebhookBridge(coordinator_db=db, signing_secret="whsec_...")
webhook.register_webhook(agent_id="agent-a", url="https://example.com/hook")
webhook.deliver(event={"type": "task_verified"})
# no signing_secret refused:
# "deliver requires the real webhook signing secret;
#  the stored hash cannot be used as the signing key"`,
  },
  {
    id: 'sdk',
    label: 'SDK',
    code: `from finalisma_sdk import FinalismaClient

client = FinalismaClient(
    coordinator_url="http://127.0.0.1:18787/mcp",
    agent_id="agent-a",
    team_id="demo",
    actor_token="fst_...",
)

# Join a room
result = client._call("finalisma_room_join", {
    "room_id": "room_8cc840e0fd9044b7ab2154af9e9c1222",
    "agent_id": "agent-a",
    "consent": True,
})
# → {"status": "active", "cursor": 0}

# Send to a group
client._call("finalisma_room_send", {
    "room_id": "room_8cc840e0fd9044b7ab2154af9e9c1222",
    "target": "builders",
    "message": {"kind": "task_update", "task_id": "task_..."},
})`,
  },
];
---

<section class="section connect" id="connect" aria-labelledby="connect-title" data-reveal-section>
  <div class="section-shell">
    <div class="section-head">
      <p class="kicker reveal">Four ways to connect</p>
      <h2 id="connect-title" class="reveal">stdio, HTTP, bridge, or SDK.</h2>
      <p class="section-lede reveal">
        Connect any agent through the transport it already speaks. All four tiers
        drive the same coordinator, the same rooms, the same evidence gate.
      </p>
    </div>

    <div class="tier-tabs" role="tablist" data-tier-tabs>
      {tiers.map((tier, i) => (
        <button
          class="tier-tab"
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-tier-tab={tier.id}
          type="button"
        >
          {tier.label}
        </button>
      ))}
    </div>

    <div class="tier-panels">
      {tiers.map((tier, i) => (
        <div
          class="tier-panel"
          role="tabpanel"
          data-tier-panel={tier.id}
          hidden={i !== 0 ? true : undefined}
        >
          <pre class="code-block" data-code-block><code>{tier.code}</code></pre>
          <button class="btn btn-sm" data-copy={tier.id} type="button">Copy config</button>
        </div>
      ))}
    </div>
    <div class="copy-status" aria-live="polite" data-tier-copy-status></div>
  </div>
</section>

<script>
  // Tier tab switching + copy
  (function () {
    const tabList = document.querySelector('[data-tier-tabs]');
    const tabs = document.querySelectorAll('[data-tier-tab]');
    const panels = document.querySelectorAll('[data-tier-panel]');
    const statusEl = document.querySelector('[data-tier-copy-status]');

    function activateTab(tab: Element) {
      const id = tab.getAttribute('data-tier-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach((p) => {
        const match = p.getAttribute('data-tier-panel') === id;
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', 'true');
      });
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (e: any) => {
        let nextIdx = idx;
        if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
        else return;
        e.preventDefault();
        tabs[nextIdx].focus();
        activateTab(tabs[nextIdx]);
      });
    });

    // Copy buttons
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const tierId = btn.getAttribute('data-copy');
        const panel = document.querySelector(`[data-tier-panel="${tierId}"]`);
        const codeEl = panel?.querySelector('code');
        const text = codeEl?.textContent || '';
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          if (statusEl) statusEl.textContent = 'Copied to clipboard.';
          btn.classList.add('is-copied');
          setTimeout(() => btn.classList.remove('is-copied'), 1500);
        } catch {
          if (statusEl) statusEl.textContent = 'Copy failed — select and copy manually.';
        }
      });
    });
  })();
</script>
