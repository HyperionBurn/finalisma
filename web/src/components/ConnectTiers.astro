---
/**
 * ConnectTiers.astro — Four connection tiers as switchable copy-paste config blocks.
 * Each tier keeps ONE short representative snippet (≤8 lines). The full config is
 * server-rendered into data-full for no-JS / a11y; a client script typewriter-reveals
 * it on scroll-in (skipped under prefers-reduced-motion).
 * Funnel lane (2026-08-07): the section closes with a configured signup link
 * when hosted is verified, or with the reproducible proof path otherwise.
 */
import {
  APP_LOGIN_LABEL,
  APP_LOGIN_URL,
  APP_ORIGIN_CONFIGURED,
  APP_ORIGIN_EXAMPLE,
  APP_SIGNUP_LABEL,
  APP_SIGNUP_URL,
} from '../lib/app';

const HOSTED_ORIGIN = APP_ORIGIN_EXAMPLE;

const HOSTED_SDK_CODE = `import os
from weft_sdk import WeftClient

client = WeftClient(
  coordinator_url="${HOSTED_ORIGIN}/mcp",
  agent_id="hosted-agent", team_id="hosted",
  bearer_token=os.environ["WEFT_TOKEN"],
)

result = client.join_room(
  room_id="room_8cc840e0fd9044b7ab2154af9e9c1222",
  link_token="rm_...",
  consent=True,
)`;

// Keep the public SDK example hosted in every build. An unconfigured build
// deliberately renders the explicit placeholder instead of a machine-local
// coordinator, because the committed site is also the raw Vercel input.
const SDK_CODE = HOSTED_SDK_CODE;

const tiers = [
  {
    id: 'stdio',
    label: 'MCP stdio',
    code: `{
  "mcpServers": {
    "weft": {
      "command": "python",
      "args": ["-B", "-m", "weft_mcp", "--remote",
        "${HOSTED_ORIGIN}",
        "--token-env", "WEFT_TOKEN"],
      "env": {"WEFT_TOKEN": "<agk_ agent key>", "PYTHONUTF8": "1"}
    }
  }
}`,
  },
  {
    id: 'http',
    label: 'Streamable HTTP',
    code: `POST /mcp HTTP/1.1
Host: ${HOSTED_ORIGIN.replace(/^https:\/\//, '')}
Content-Type: application/json
Authorization: Bearer <agk_ agent key>

{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}`,
  },
  {
    id: 'bridge',
    label: 'Bridge adapters',
    code: `from weft_mcp.bridge import ClipboardBridge

# Bind to the authenticated local coordinator store:
clipboard = ClipboardBridge(store)
snippet = clipboard.generate_bootstrap(
    team_id="demo",
    agent_id="agent-a",
    endpoint="http://127.0.0.1:8787",
    pairing_id=pairing["pairing_id"],
    join_token=pairing["join_token"],
    actor_token=actor_token,
)
# Parse once; a second parse is refused by the nonce guard.`,
  },
  {
    id: 'sdk',
    label: 'SDK',
    code: SDK_CODE,
  },
];
---

<section class="section connect" id="connect" aria-labelledby="connect-title" data-reveal-section>
  <div class="section-shell">
    <div class="section-head">
      <p class="kicker eyebrow scroll-in">Four ways to connect</p>
      <h2 id="connect-title" class="scroll-in" style="--delay:80ms">stdio, HTTP, bridge, or SDK.</h2>
      <p class="section-lede scroll-in" style="--delay:160ms">
        Connect any agent through the transport it already speaks. On a configured hosted
        service your agent connects via Streamable HTTP, or via an MCP stdio
        bridge configured for remote mode; bridge-adapter examples target a
        self-hosted coordinator while the SDK example uses hosted bearer mode.
        The placeholder remains explicit until a verified origin is configured.
        Tool count depends on the surface: the hosted
        <code>POST /mcp</code> exposes 14 room tools; the self-hosted coordinator
        exposes 59.
        {!APP_ORIGIN_CONFIGURED && ' This build has no verified hosted origin, so use the self-hosted proof path below.'}
      </p>
    </div>

    <div class="tier-tabs scroll-in" style="--delay:240ms" role="tablist" aria-labelledby="connect-title" data-tier-tabs>
      {tiers.map((tier, i) => (
        <button
          class="tier-tab"
          role="tab"
          id={`tier-tab-${tier.id}`}
          aria-controls={`tier-panel-${tier.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-tier-tab={tier.id}
          type="button"
        >
          {tier.label}
        </button>
      ))}
    </div>

    <div class="tier-panels">
      {tiers.map((tier, i) => (
        <div
          class="bezel tier-panel"
          role="tabpanel"
          id={`tier-panel-${tier.id}`}
          aria-labelledby={`tier-tab-${tier.id}`}
          tabindex="0"
          data-tier-panel={tier.id}
        >
          <div class="bezel__core">
            <pre class="code-block is-typewriter" data-code-block data-full={tier.code}><code>{tier.code}</code><span class="code-block__caret" aria-hidden="true"></span></pre>
            <button class="btn btn-sm group" data-copy={tier.id} type="button">Copy config<span class="btn__icon" aria-hidden="true">→</span></button>
          </div>
        </div>
      ))}
    </div>
    <div class="copy-status" aria-live="polite" data-tier-copy-status></div>

    <div class="connect-cta scroll-in" style="--delay:320ms">
      <p class="connect-cta__lede">
        Four transports, one room. {!APP_ORIGIN_CONFIGURED
          ? 'Run the self-hosted proof now, or configure a verified hosted origin at build time.'
          : 'Create an account and open one, then your agents join through the transport they already speak.'}
      </p>
      <div class="connect-cta__actions">
        <a class="btn btn-accent btn-lg group" href={APP_SIGNUP_URL}>{APP_SIGNUP_LABEL}<span class="btn__icon" aria-hidden="true">→</span></a>
        <a class="connect-cta__login" href={APP_LOGIN_URL}>{APP_LOGIN_LABEL}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .code-block.is-typewriter { position: relative; }
  .code-block__caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    vertical-align: -0.15em;
    background: currentColor;
    opacity: 0;
    margin-left: 0.1ch;
  }
  .code-block.is-typing .code-block__caret { opacity: 1; animation: weft-blink 1s steps(1) infinite; }
  .code-block.is-done .code-block__caret { opacity: 0; }
  @keyframes weft-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .code-block__caret { display: none !important; }
  }

  /* Funnel lane: closing CTA for the connect section */
  .connect-cta {
    margin-top: 2rem;
    padding: 2rem;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-surface-2) 80%, transparent);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .connect-cta__lede {
    margin: 0;
    max-width: 44ch;
    color: var(--color-text-muted);
  }
  .connect-cta__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .connect-cta__login {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .connect-cta__login:hover { color: var(--color-accent); }

  /* Mobile touch-target floor (44px) — hit area only, type unchanged */
  @media (max-width: 768px) {
    .connect-cta__login {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>

<script>
  // Tier tab switching + copy + code-block typewriter
  (function () {
    const tabList = document.querySelector('[data-tier-tabs]');
    const tabs = document.querySelectorAll('[data-tier-tab]');
    const panels = document.querySelectorAll('[data-tier-panel]');
    const statusEl = document.querySelector('[data-tier-copy-status]');

    function activateTab(tab: Element) {
      const id = tab.getAttribute('data-tier-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.setAttribute('tabindex', active ? '0' : '-1');
      });
      panels.forEach((p) => {
        const match = p.getAttribute('data-tier-panel') === id;
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', 'true');
      });
    }

    // Keep every panel server-visible for no-JS users; JS owns the interactive
    // single-panel presentation once the page has hydrated.
    if (tabs[0]) activateTab(tabs[0]);

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => activateTab(tab));
      tab.addEventListener('keydown', (e: any) => {
        let nextIdx = idx;
        if (e.key === 'ArrowRight') nextIdx = (idx + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + tabs.length) % tabs.length;
        else return;
        e.preventDefault();
        tabs[nextIdx].focus();
        activateTab(tabs[nextIdx]);
      });
    });

    // Copy buttons — always use the FULL source string (data-full), not the
    // partially-revealed DOM text, so copying mid-type still gets everything.
    // Scope to THIS section's tier panels: [data-tier-tabs] is a sibling of
    // the panels, so match copy buttons inside the tier-panels container only.
    // (A bare `[data-copy]` selector also catches LiveDemo's data-copy="link"
    // button, which would double-handle it and overwrite the copied link.)
    document.querySelectorAll('.tier-panels [data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const tierId = btn.getAttribute('data-copy');
        const panel = document.querySelector(`[data-tier-panel="${tierId}"]`);
        const block = panel?.querySelector('[data-code-block]');
        const full = block?.getAttribute('data-full') || '';
        const text = full;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          if (statusEl) statusEl.textContent = 'Copied to clipboard.';
          btn.classList.add('is-copied');
          setTimeout(() => btn.classList.remove('is-copied'), 1500);
        } catch {
          if (statusEl) statusEl.textContent = 'Copy failed — select and copy manually.';
        }
      });
    });

    // Typewriter reveal per code block on scroll-in.
    const reduced =
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-code-block]').forEach((block) => {
      const full = block.getAttribute('data-full') || '';
      const code = block.querySelector('code');

      if (reduced || !('IntersectionObserver' in window) || !code) {
        block.classList.add('is-done');
        return;
      }

      // Start empty; reveal line by line when scrolled into view.
      code.textContent = '';
      block.classList.add('is-typing');

      const lines = full.split('\n');
      let lineIdx = 0;
      let timer: number | undefined;

      function typeNext() {
        if (lineIdx >= lines.length) {
          block.classList.remove('is-typing');
          block.classList.add('is-done');
          return;
        }
        if (lineIdx > 0) code.appendChild(document.createTextNode('\n'));
        code.appendChild(document.createTextNode(lines[lineIdx]));
        lineIdx += 1;
        timer = window.setTimeout(typeNext, 140);
      }

      const io = new IntersectionObserver(
        (entries, obs) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              obs.unobserve(entry.target);
              timer = window.setTimeout(typeNext, 180);
            }
          }
        },
        { threshold: 0.25 }
      );
      io.observe(block);
    });
  })();
</script>
