---
/**
 * AppShell.astro — chrome for every authenticated screen.
 *
 * Left rail, main column, and whatever the page puts in it. The rail lists
 * rooms with live state because that is what a person opens this for; the
 * settings links sit underneath, quiet, where they belong.
 *
 * The rooms and the account identity are islands, NOT static markup. They
 * were once a hardcoded array and a hardcoded email address, which meant
 * every account saw four invented rooms and the author's address on every
 * page - while the main column, which did ask the service, said "No rooms
 * yet" directly beside it.
 *
 * Room state is shown as a dot AND a figure, never colour alone — a green
 * pill that means "healthy" is invisible to a colour-blind operator, and
 * this is a surface people will scan under pressure.
 */
import '../styles/app.css';
import RailRooms from '../components/app/RailRooms.tsx';
import RailAccount from '../components/app/RailAccount.tsx';

interface Props {
  title: string;
  current?: string;
}
const { title, current = '' } = Astro.props;
const path = Astro.url.pathname;
const roomsCurrent = current === '' && ['/app', '/app/new', '/app/room'].includes(path);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title} · Weft</title>
  <meta name="theme-color" content="#050505" />
  <meta name="color-scheme" content="dark" />
  <meta name="robots" content="noindex" />
</head>

<body>
  <!-- Every interactive surface in this shell is a React island: the forms carry
       no action/method and no named fields, the lists are API-driven, and the
       buttons look enabled because they are ordinary buttons. Without JS they do
       nothing at all, silently — an enabled control that cannot act is a false
       affordance, and saying so is the least we owe someone in that position.
       This does not fix the underlying JS requirement; it stops the page lying
       about it. -->
  <noscript>
    <div style="background:#1a1206;border-bottom:1px solid #c39a4a;color:#f0e6d2;
                padding:12px 20px;font:400 14px/1.5 system-ui,sans-serif;text-align:center">
      This part of Weft needs JavaScript to run. The controls below are visible
      but will not work until it is enabled — nothing you type here is sent.
    </div>
  </noscript>

  <div class="app">
    <aside class="rail">
      <a class="rail__brand" href="/app">
        <svg viewBox="0 0 31.5 48.5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M21.5 0 L21.5 19.5 L31.5 19.5 L31.5 29 L10 48.5 L10 28.5 L0.5 28.5 L0.5 18.5 Z" fill="#8e8e8e"/>
          <rect x="0.5" y="18.5" width="9" height="10" fill="#fdfdfd"/>
          <rect x="22" y="19.5" width="9.5" height="9.5" fill="#fdfdfd"/>
        </svg>
        Weft
      </a>

      <p class="rail__label">Rooms</p>
      <RailRooms client:load />

      <p class="rail__label">Account</p>
      <nav class="rail__group" aria-label="Account">
        <a class="nav" href="/app/keys" aria-current={current === 'keys' ? 'page' : undefined}>
          <svg class="nav__ico" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <circle cx="5.5" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/>
            <path d="M8.5 8H14M12 8v2.5M10 8v1.8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span class="nav__n">Agent keys</span>
        </a>
        <a class="nav" href="/app/connect" aria-current={current === 'connect' ? 'page' : undefined}>
          <svg class="nav__ico" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 2.8 3 5.9a3 3 0 0 0 4.2 4.2l.9-.9M10 13.2l3-3.1a3 3 0 0 0-4.2-4.2l-.9.9"
              stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span class="nav__n">Connect an agent</span>
        </a>
        <a class="nav" href="/app/usage" aria-current={current === 'usage' ? 'page' : undefined}>
          <svg class="nav__ico" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M2.5 13V9M6.5 13V4M10.5 13V7M14 13V2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span class="nav__n">Usage</span>
        </a>
      </nav>

      <div class="rail__foot">
        <RailAccount client:load />
      </div>
    </aside>

    <main class="main" id="main-content">
      <nav class="mbar" aria-label="Primary">
        <a class="mbar__brand" href="/app">Weft</a>
        <span class="mbar__nav">
          <a class="mbar__link" href="/app" aria-current={roomsCurrent ? 'page' : undefined}>Rooms</a>
          <a class="mbar__link" href="/app/keys" aria-current={current === 'keys' ? 'page' : undefined}>Keys</a>
          <a class="mbar__link" href="/app/usage" aria-current={current === 'usage' ? 'page' : undefined}>Usage</a>
        </span>
        <a class="mbar__account" href="/app/settings" aria-current={current === 'settings' ? 'page' : undefined}>Account</a>
      </nav>
      <slot />
    </main>
  </div>

</body>
</html>
