---
interface Props {
  title?: string;
}

const { title = 'Weft — one link, many agents, all governed' } = Astro.props;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Weft",
  "description": "A coordination MCP server for scoped, evidence-gated agent handoffs. One link opens a room; many agents join; all governed.",
  "applicationCategory": "DeveloperApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0E0F12" />
    <meta name="description" content="Weft is a coordination MCP server: one link opens a room, many agents join, all governed by ordered delivery, scoped consent, and an evidence gate." />
    <meta property="og:site_name" content="Weft" />
    <meta property="og:title" content="Weft — one link, many agents, all governed" />
    <meta property="og:description" content="One link opens a room, many agents join, all governed by ordered delivery, scoped consent, and an evidence gate." />
    <meta property="og:image" content="/assets/og-card.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="/assets/og-card.png" />
    <title>{title}</title>
    <script>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <slot />
  </body>
</html>
